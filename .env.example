# SentinelOps AI - Environment Configuration Example
# Copy this file to .env for local development

# Application
ENVIRONMENT=development
PROJECT_NAME="SentinelOps AI"
VERSION=1.0.0
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_64_character_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APPROVAL_TOKEN_EXPIRE_MINUTES=15

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sentinelops
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TIMEOUT_SECONDS=10

# AI / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
AI_INFERENCE_TIMEOUT_SECONDS=45
FALLBACK_TO_MOCK_AI=true

# Telemetry Integrations
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
LOKI_URL=http://localhost:3100

# Monitored Target Service (Sample)
PAYMENT_SERVICE_URL=http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

